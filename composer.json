{
    "name": "gratlinie/contao-gratmap",
    "description": "GratMap – Standort- und Händlerkarten mit Umkreissuche für Contao",
    "type": "contao-bundle",
    "license": "proprietary",
    "authors": [
        {
            "name": "Gratlinie",
            "email": "mail@gratlinie.de"
        }
    ],
    "require": {
        "php": "^8.2",
        "contao/core-bundle": "^5.7",
        "symfony/http-client": "^6.4 || ^7.0"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.0"
    },
    "conflict": {
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "autoload": {
        "psr-4": {
            "Gratlinie\\GratMapBundle\\": "src/"
        }
    },
    "extra": {
        "contao-manager-plugin": "Gratlinie\\GratMapBundle\\ContaoManager\\Plugin"
    }
}
